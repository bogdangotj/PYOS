[INFO]
name: game
description: Игра "Угадай число" с подсчётом попыток и уведомлениями
version: 2.0.0
author: Kostyl Studios
tag: Game
background: false

[CODE]
color("=== Игра 'Угадай число' v2.0 ===", "magenta")
print()

target = random.randint(1, 100)
attempts = 0

color("Я загадал число от 1 до 100.", "cyan")
color("Попробуйте угадать!", "cyan")
print()

while True:
    val = input("Ваша догадка (или 'exit'): ").strip()
    
    if val.lower() in ('exit', 'quit', 'q'):
        print(f"Игра прервана. Было загадано: {target}")
        break
    
    if not val.isdigit():
        color("  Введите целое число!", "red")
        continue
    
    num = int(val)
    attempts += 1
    
    if num < target:
        color("  Моё число больше!", "yellow")
    elif num > target:
        color("  Моё число меньше!", "yellow")
    else:
        color(f"ПОЗДРАВЛЯЕМ! Угадали за {attempts} попыток!", "green")
        notify("Игра: Угадай число", f"Победа за {attempts} попыток!")
        break
[/CODE]

