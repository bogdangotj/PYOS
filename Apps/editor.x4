[INFO]
name: editor
description: Текстовый редактор с созданием, чтением и удалением файлов
version: 2.1.0
author: Kostyl Studios
tag: Technical
background: false

[CODE]
color("=== Текстовый редактор v2.1 ===", "cyan")
print()

notes_dir = "/apps/data/editor"
fmkdir(notes_dir)

while True:
    color("1. Создать файл", "white")
    color("2. Открыть файл", "white")
    color("3. Список файлов", "white")
    color("4. Удалить файл", "white")
    color("5. Выход", "white")
    print()
    
    choice = input("Выберите (1-5): ").strip()
    
    if choice == "1":
        name = input("  Имя файла: ").strip()
        if name:
            text = input("  Содержимое: ")
            fwrite(f"{notes_dir}/{name}.txt", text)
            color("  Сохранено!", "green")
    elif choice == "2":
        name = input("  Имя файла: ").strip()
        data = fread(f"{notes_dir}/{name}.txt")
        if data:
            print(f"  -- {name} --")
            print(data)
            print("  -- конец --")
        else:
            color("  Не найдено.", "red")
    elif choice == "3":
        items = flist(notes_dir)
        if items:
            print("  Файлы:")
            for it in items:
                print(f"    * {it}")
        else:
            print("  Файлов нет.")
    elif choice == "4":
        name = input("  Имя файла: ").strip()
        fdelete(f"{notes_dir}/{name}.txt")
        color("  Удалено.", "yellow")
    elif choice in ("5", "exit", "q"):
        color("Редактор закрыт.", "green")
        break
    else:
        print("  Неверный выбор.")
    print()
[/CODE]

[DATA]
folder: /apps/data/editor
