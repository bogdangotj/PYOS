[INFO]
name: notes
description: Менеджер текстовых заметок с цветовым выводом
version: 1.1.0
author: Kostyl Studios
tag: Technical
background: false

[CODE]
color("=== Менеджер заметок ===", "cyan")
print()

notes_dir = "/apps/data/notes"
fmkdir(notes_dir)

while True:
    color("1. Создать заметку", "white")
    color("2. Прочитать заметку", "white")
    color("3. Список заметок", "white")
    color("4. Удалить заметку", "white")
    color("5. Выход", "white")
    print()
    
    choice = input("Выберите (1-5): ").strip()
    
    if choice == "1":
        name = input("  Имя заметки: ").strip()
        if name:
            text = input("  Текст: ")
            fwrite(f"{notes_dir}/{name}.txt", text)
            color("  Сохранено!", "green")
    elif choice == "2":
        name = input("  Имя заметки: ").strip()
        data = fread(f"{notes_dir}/{name}.txt")
        if data:
            print(f"  -- {name} --")
            print(data)
        else:
            color("  Не найдено.", "red")
    elif choice == "3":
        items = flist(notes_dir)
        if items:
            print("  Заметки:")
            for it in items:
                print(f"    * {it}")
        else:
            print("  Заметок нет.")
    elif choice == "4":
        name = input("  Имя заметки: ").strip()
        fdelete(f"{notes_dir}/{name}.txt")
        color("  Удалено.", "yellow")
    elif choice in ("5", "exit", "q"):
        color("Менеджер заметок закрыт.", "green")
        break
    else:
        print("  Неверный выбор.")
    print()
[/CODE]

[DATA]
folder: /apps/data/notes
[/DATA]

