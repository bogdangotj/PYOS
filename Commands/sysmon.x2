[INFO]
name: sysmon
description: Мониторинг системы - время, сессия, диск, базовая информация
version: 2.1.0
author: Kostyl Studios
tag: System
background: false

[CODE]
color("=== Системный мониторинг ===", "cyan")
print()

# Время и сессия
now = datetime.datetime.now()
print(f"  Текущее время: {now.strftime('%H:%M:%S %d.%m.%Y')}")
print(f"  Сессия:        {safety.session_str()}")
print()

# Базовая информация
print(f"  Пользователь:    {shell.user}")
print(f"  Компьютер:       {kernel.hostname}")
print(f"  ОС:              PyOS v{kernel.VERSION} build {kernel.BUILD}")
print(f"  Компания:        {kernel.COMPANY}")
print()

# Диск (текущий)
usage = fs.disk_usage()
print(f"  Диск занят:      {safety.fmt_size(usage)}")
[/CODE]

[DATA]
folder: /apps/data/sysmon
