[CODE]
print("=== Научный калькулятор v2.1 ===")
print("Поддерживаемые функции: sin, cos, tan, log, sqrt, pow и др.")
print("Введите выражение или 'exit' для выхода")
print()

import math

while True:
    try:
        expr = input("calc> ").strip()
        if expr.lower() in ('exit', 'quit', 'q'):
            print("Калькулятор завершён.")
            break
        if not expr:
            continue
        
        # Безопасная оценка выражения
        allowed_names = {
            k: getattr(math, k) for k in dir(math) if not k.startswith('_')
        }
        allowed_names.update({'abs': abs, 'round': round, 'min': min, 'max': max})
        
        result = eval(expr, {"__builtins__": {}}, allowed_names)
        print(f"  = {result}")
    except Exception as e:
        print(f"  Ошибка: {e}")
