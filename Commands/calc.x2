[INFO]
name: calc
description: Научный калькулятор с безопасным вычислением математических выражений
version: 2.2.0
author: Kostyl Studios
tag: Technical
background: false

[CODE]
color("=== Научный калькулятор v2.2 ===", "cyan")
print("Поддерживаемые функции: sin, cos, tan, sqrt, log, pow, abs, round, min, max, pi, e")
print("Введите выражение или 'exit' для выхода")
print()

while True:
    expr = input("calc> ").strip()
    if expr.lower() in ('exit', 'quit', 'q'):
        color("Калькулятор завершён.", "green")
        break
    if not expr:
        continue
    try:
        result = eval(expr)
        color(f"  = {result}", "green")
    except Exception as e:
        color(f"  Ошибка: {e}", "red")
[/CODE]

